{
  "type": "page",
  "props": {
    "title": "L2 - Fermentation Control",
    "nav": [
      {"href": "?screen=L2-SCADA/brewhouse", "label": "Brewhouse"},
      {"href": "?screen=L2-SCADA/fermentation", "label": "Fermentation", "active": true},
      {"href": "?screen=L2-SCADA/packaging", "label": "Packaging"},
      {"href": "?screen=L2-SCADA/utilities", "label": "Utilities"},
      {"href": "?screen=L2-SCADA/recipes", "label": "Recipes"},
      {"href": "?screen=L3-MES/batch-exec", "label": "↑ L3 MES"},
      {"href": "?screen=L1-Control/sequences", "label": "↓ L1 Control"}
    ],
    "leds": [{"label": "Glycol", "state": "grn"}, {"label": "Temps", "state": "grn"}]
  },
  "children": [{
    "type": "flex",
    "props": {"direction": "column", "gap": "15px"},
    "children": [
      {
        "type": "grid",
        "props": {"columns": 6, "gap": "12px"},
        "children": [
          {"type": "stat-card", "props": {"title": "Active FVs", "value": "4", "unit": "/6", "color": "#0ff"}},
          {"type": "stat-card", "props": {"title": "Avg Temp", "value": "64.2", "unit": "°F", "color": "#0f0"}},
          {"type": "stat-card", "props": {"title": "Glycol Temp", "value": "28", "unit": "°F", "color": "#00f"}},
          {"type": "stat-card", "props": {"title": "Active Batches", "value": "4", "color": "#ffa500"}},
          {"type": "stat-card", "props": {"title": "Oldest Batch", "value": "14", "unit": "days", "color": "#ff6b35"}},
          {"type": "stat-card", "props": {"title": "Ready Soon", "value": "2", "color": "#0f0"}}
        ]
      },
      {
        "type": "card",
        "props": {"title": "Fermenters"},
        "children": [{
          "type": "vessel-row",
          "props": {
            "mode": "3d",
            "vessels": [
              {"name": "FV1", "temp": "{fv1.temp}", "level": "{fv1.level}", "color": "#0ff", "setpoint": "{fv1.sp}", "batch": "{fv1.batch}", "day": "{fv1.day}"},
              {"name": "FV2", "temp": "{fv2.temp}", "level": "{fv2.level}", "color": "#0ff", "setpoint": "{fv2.sp}", "batch": "{fv2.batch}", "day": "{fv2.day}"},
              {"name": "FV3", "temp": "{fv3.temp}", "level": "{fv3.level}", "color": "#0ff", "setpoint": "{fv3.sp}", "batch": "{fv3.batch}", "day": "{fv3.day}"},
              {"name": "FV4", "temp": "{fv4.temp}", "level": "{fv4.level}", "color": "#0ff", "setpoint": "{fv4.sp}", "batch": "{fv4.batch}", "day": "{fv4.day}"},
              {"name": "FV5", "temp": "{fv5.temp}", "level": "{fv5.level}", "color": "#444", "empty": true},
              {"name": "FV6", "temp": "{fv6.temp}", "level": "{fv6.level}", "color": "#444", "empty": true}
            ]
          }
        }]
      },
      {
        "type": "grid",
        "props": {"columns": 2, "gap": "15px"},
        "children": [
          {
            "type": "card",
            "props": {"title": "Fermentation Status"},
            "children": [{
              "type": "table",
              "props": {
                "columns": [
                  {"field": "fv", "header": "FV"},
                  {"field": "batch", "header": "Batch"},
                  {"field": "recipe", "header": "Recipe"},
                  {"field": "day", "header": "Day"},
                  {"field": "og", "header": "OG"},
                  {"field": "sg", "header": "SG"},
                  {"field": "att", "header": "Att%"},
                  {"field": "status", "header": "Status"}
                ],
                "data": "{ferm.status}"
              }
            }]
          },
          {
            "type": "card",
            "props": {"title": "Temperature Trends (24h)"},
            "children": [{
              "type": "trend",
              "props": {"data": "{ferm.tempTrend}", "height": 150, "color": "#0ff"}
            }]
          }
        ]
      }
    ]
  }]
}
