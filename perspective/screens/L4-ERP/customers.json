{
  "type": "page",
  "props": {
    "title": "L4 - Customer Management",
    "nav": [
      {"href": "?screen=L4-ERP/finance", "label": "Finance"},
      {"href": "?screen=L4-ERP/supply-chain", "label": "Supply Chain"},
      {"href": "?screen=L4-ERP/customers", "label": "Customers", "active": true},
      {"href": "?screen=sales", "label": "↓ Sales Orders"}
    ]
  },
  "children": [{
    "type": "flex",
    "props": {"direction": "column", "gap": "15px"},
    "children": [
      {
        "type": "grid",
        "props": {"columns": 4, "gap": "12px"},
        "children": [
          {"type": "stat-card", "props": {"title": "Active Accounts", "value": "24", "color": "#0ff"}},
          {"type": "stat-card", "props": {"title": "New This Month", "value": "3", "trend": "+2", "color": "#0f0"}},
          {"type": "stat-card", "props": {"title": "Avg Order Value", "value": "485", "unit": "$", "color": "#ffa500"}},
          {"type": "stat-card", "props": {"title": "Retention Rate", "value": "92", "unit": "%", "color": "#0f0"}}
        ]
      },
      {
        "type": "card",
        "props": {"title": "Customer Accounts"},
        "children": [{
          "type": "table",
          "props": {
            "columns": [
              {"field": "name", "header": "Account"},
              {"field": "type", "header": "Type"},
              {"field": "contact", "header": "Contact"},
              {"field": "ytdRev", "header": "YTD Revenue"},
              {"field": "lastOrder", "header": "Last Order"},
              {"field": "terms", "header": "Terms"},
              {"field": "status", "header": "Status"}
            ],
            "data": "{erp.customers}"
          }
        }]
      },
      {
        "type": "grid",
        "props": {"columns": 2, "gap": "15px"},
        "children": [
          {
            "type": "card",
            "props": {"title": "Revenue by Channel"},
            "children": [{
              "type": "flex",
              "props": {"direction": "column", "gap": "6px"},
              "children": [
                {"type": "labeled-bar", "props": {"label": "On-Premise", "value": 65, "min": 0, "max": 100, "color": "#ff6b35"}},
                {"type": "labeled-bar", "props": {"label": "Distribution", "value": 25, "min": 0, "max": 100, "color": "#0ff"}},
                {"type": "labeled-bar", "props": {"label": "Taproom", "value": 10, "min": 0, "max": 100, "color": "#0f0"}}
              ]
            }]
          },
          {
            "type": "card",
            "props": {"title": "A/R Aging"},
            "children": [{
              "type": "table",
              "props": {
                "columns": [
                  {"field": "bucket", "header": "Aging"},
                  {"field": "amount", "header": "Amount"},
                  {"field": "pct", "header": "%"}
                ],
                "data": "{erp.arAging}"
              }
            }]
          }
        ]
      }
    ]
  }]
}
