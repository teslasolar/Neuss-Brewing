{
  "type": "page",
  "props": {
    "title": "Neuss Brewing SCADA",
    "batch": "{batch.id}",
    "recipe": "{batch.recipe}",
    "state": "{batch.state}",
    "nav": [
      {"href": "overview.html", "label": "Overview", "active": true},
      {"href": "brewhouse.html", "label": "Brewhouse"},
      {"href": "fermentation.html", "label": "Fermentation"},
      {"href": "recipes.html", "label": "Recipes"},
      {"href": "history.html", "label": "History"}
    ],
    "footer": "Neuss Brewing SCADA v1.0",
    "leds": [
      {"label": "PLC", "state": "grn"},
      {"label": "DB", "state": "grn"},
      {"label": "Alarms", "state": "{alarms.active?'red':'grn'}"}
    ]
  },
  "children": [{
    "type": "sidebar-layout",
    "props": {"width": "220px"},
    "children": [{
      "type": "flex",
      "props": {"direction": "column", "gap": "15px"},
      "children": [
        {
          "type": "card",
          "props": {"title": "Brewhouse"},
          "children": [{
            "type": "vessel-row",
            "props": {
              "mode": "3d",
              "vessels": [
                {"name": "HLT", "temp": "{vessels.hlt.temp}", "level": "{vessels.hlt.level}", "color": "#4169e1"},
                {"name": "MLT", "temp": "{vessels.mlt.temp}", "level": "{vessels.mlt.level}", "color": "#8b4513"},
                {"name": "BK", "temp": "{vessels.bk.temp}", "level": "{vessels.bk.level}", "color": "#daa520"}
              ]
            }
          }]
        },
        {
          "type": "card",
          "props": {"title": "Fermenters"},
          "children": [{
            "type": "flex",
            "props": {"gap": "10px", "wrap": "wrap", "justify": "center"},
            "children": [
              {"type": "fermenter", "props": {"name": "FV1", "status": "{fv1.status}", "beer": "{fv1.beer}", "temp": "{fv1.temp}", "sg": "{fv1.sg}", "level": "{fv1.level}", "progress": "{fv1.progress}", "days": "{fv1.days}"}},
              {"type": "fermenter", "props": {"name": "FV2", "status": "{fv2.status}", "beer": "{fv2.beer}", "temp": "{fv2.temp}", "sg": "{fv2.sg}", "level": "{fv2.level}", "progress": "{fv2.progress}", "days": "{fv2.days}"}},
              {"type": "fermenter", "props": {"name": "FV3", "status": "{fv3.status}", "beer": "{fv3.beer}", "temp": "{fv3.temp}", "sg": "{fv3.sg}", "level": "{fv3.level}", "progress": "{fv3.progress}", "days": "{fv3.days}"}}
            ]
          }]
        }
      ]
    }],
    "sidebar": [{
      "type": "metrics-panel",
      "props": {
        "title": "Live Metrics",
        "metrics": [
          {"label": "Batch", "value": "{batch.id}", "color": "#ffa500"},
          {"label": "Phase", "value": "{batch.phase}", "color": "#0f0"},
          {"label": "Duration", "value": "{batch.duration}", "unit": "min"},
          {"label": "Target Temp", "value": "{batch.targetTemp}", "unit": "°F"},
          {"label": "Efficiency", "value": "{batch.efficiency}", "unit": "%"}
        ]
      }
    }]
  }]
}
