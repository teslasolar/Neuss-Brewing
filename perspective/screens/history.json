{
  "type": "page",
  "props": {
    "title": "Batch History",
    "nav": [
      {"href": "overview.html", "label": "Overview"},
      {"href": "brewhouse.html", "label": "Brewhouse"},
      {"href": "fermentation.html", "label": "Fermentation"},
      {"href": "recipes.html", "label": "Recipes"},
      {"href": "history.html", "label": "History", "active": true}
    ]
  },
  "children": [{
    "type": "flex",
    "props": {"direction": "column", "gap": "15px"},
    "children": [
      {
        "type": "card",
        "props": {"title": "Completed Batches"},
        "children": [{
          "type": "table",
          "props": {
            "columns": [
              {"field": "id", "header": "Batch"},
              {"field": "recipe", "header": "Recipe"},
              {"field": "date", "header": "Date"},
              {"field": "og", "header": "OG"},
              {"field": "fg", "header": "FG"},
              {"field": "abv", "header": "ABV"},
              {"field": "status", "header": "Status"}
            ],
            "data": "{history.batches}"
          }
        }]
      },
      {
        "type": "card",
        "props": {"title": "Temperature Trends"},
        "children": [{
          "type": "trend",
          "props": {"data": "{history.tempTrend}", "width": 400, "height": 100, "color": "#ff6b35"}
        }]
      }
    ]
  }]
}
