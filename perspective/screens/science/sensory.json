              {"date": "12/04", "batch": "HAZY-028", "product": "Hazy Days", "aroma": "4.5", "appearance": "4.5", "flavor": "4.0", "mouth": "4.5", "overall": "4.4", "notes": "Great haze"},
              {"date": "12/03", "batch": "PALE-032", "product": "Session Pale", "aroma": "4.0", "appearance": "4.5", "flavor": "4.0", "mouth": "4.0", "overall": "4.1", "notes": "Balanced"}
