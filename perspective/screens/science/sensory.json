                  {"flavor": "Acetaldehyde", "cause": "Young beer", "threshold": "5-10 ppm", "lastSeen": "Never"},
                  {"flavor": "DMS", "cause": "Poor boil/chill", "threshold": "30-50 ppb", "lastSeen": "Never"},
